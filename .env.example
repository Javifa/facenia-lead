# =====================================================================
# BuscaLeads (FACENIA) — Plantilla de Variables de Entorno (.env.example)
# =====================================================================
# Copia este archivo como `.env` en tu equipo local o configura estas
# variables en el panel de Environment Variables de tu servidor.
# NUNCA subas el archivo `.env` real a GitHub ni expongas la clave en el cliente.

# 1. Clave de servidor para Google Maps Platform — Places API (New)
# Dejar vacía hasta configurar tu proyecto en Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# 2. Proveedor de datos predeterminado: "google_places" o "osm" (OpenStreetMap)
DEFAULT_DATA_PROVIDER=google_places

# 3. Control de consumo y límites por búsqueda en Google Places API (New)
PLACES_MAX_RESULTS_PER_SEARCH=20
PLACES_MAX_REQUESTS_PER_SEARCH=3

# 4. Base de datos en la nube Supabase (Proyecto Facenia)
SUPABASE_URL=
SUPABASE_KEY=

# 5. Ruta de la base de datos SQLite local (caché / respaldo local)
DATABASE_PATH=facenia_leads.db
